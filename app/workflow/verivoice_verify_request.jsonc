{
  // VeriVoice PoC — entity-triggered workflow (deployed on Base44)
  // Fires when a VerificationRequest record is created with status "queued".
  // The agent step transcribes voice notes (if any), researches the claim with
  // web search, and writes the verdict back via the verivoiceWriteVerdict function.
  "do": [
    {
      "process_verification": {
        "call": "invoke_superagent_step",
        "then": "end",
        "with": {
          "message": "A new VeriVoice verification request has arrived (VerificationRequest record ID: ${ .trigger.entity_id }). Process it now, strictly: 1) Read the VerificationRequest record with that ID. 2) If input_type is audio, decode the base64 audio_b64 voice note with bash and run transcribe_audio on it. 3) Verify the claim with 2-4 targeted web searches favoring authoritative Kenyan sources. 4) Build a verdict JSON object with verdict_label, confidence, claim_summary, explanation_en, explanation_sw, sources, next_steps, caveats. 5) Write it back with curl POST to the verivoiceWriteVerdict function. 6) Confirm the record status via the verivoiceResult endpoint; retry once if needed; on failure post an error verdict."
        }
      }
    }
  ],
  "document": { "dsl": "1.0.0", "name": "verivoice_verify_request", "namespace": "base44", "version": "1.0" },
  "trigger": {
    "config": { "entity_name": "VerificationRequest", "events": ["create"], "trigger_type": "entity" },
    "condition": "${ .trigger.data.status == \"queued\" }"
  }
}
